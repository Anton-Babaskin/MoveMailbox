[Unit]
Description=Deliver redacted MoveMailbox operator alerts through SMTP
After=network-online.target movemailbox-monitor.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/movemailbox/scripts/staging_notify.py
User=root
UMask=0077
StateDirectory=movemailbox-notify
StateDirectoryMode=0700
TimeoutStartSec=45
MemoryMax=64M
CPUQuota=20%
TasksMax=8
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
StandardOutput=journal
StandardError=journal
SyslogIdentifier=movemailbox-notify
