MOVEMAILBOX_ADDR=127.0.0.1:8080
MOVEMAILBOX_IMAPSYNC_BIN=imapsync
MOVEMAILBOX_MAX_CONCURRENT=2
MOVEMAILBOX_MAX_JOBS=256
MOVEMAILBOX_HISTORY_TTL=24h
MOVEMAILBOX_DEMO=false
MOVEMAILBOX_OPEN_BROWSER=true
# Comma-separated exact Host values (including a forwarded port) for a proxy.
# Loopback hosts are allowed automatically.
MOVEMAILBOX_ALLOWED_HOSTS=

# Public mode is for an HTTPS reverse proxy. Generate a unique secret with at
# least 32 random bytes; never commit or reuse it.
MOVEMAILBOX_PUBLIC_MODE=false
MOVEMAILBOX_SESSION_SECRET=
MOVEMAILBOX_SESSION_TTL=24h
MOVEMAILBOX_MAX_ACTIVE_PER_SESSION=1
MOVEMAILBOX_SESSION_REQUESTS_PER_MINUTE=120
MOVEMAILBOX_IP_REQUESTS_PER_MINUTE=600
# Required in public mode: base64 for at least 32 random bytes. Keep it in the
# deployment secret manager, never in Git or a database backup.
MOVEMAILBOX_MASTER_KEY=
MOVEMAILBOX_CREDENTIAL_TTL=24h
MOVEMAILBOX_WORKER_LEASE_TTL=2h

# Docker Compose build metadata and resource ceilings.
MOVEMAILBOX_BUILD_VERSION=dev
MOVEMAILBOX_CPU_LIMIT=2.0
MOVEMAILBOX_MEMORY_LIMIT=1g
MOVEMAILBOX_PIDS_LIMIT=256
