{
  "name": "movemailbox-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next build && node scripts/embed.mjs",
    "lint": "next lint",
    "build:static": "NEXT_PUBLIC_STATIC_SITE=1 next build && npm run csp",
    "csp": "node scripts/add-csp.mjs",
    "check": "node scripts/check-export.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ],
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
